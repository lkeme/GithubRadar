# 复制为同目录 .env 后按需修改

# 浏览器实际访问本站使用的完整 Origin（scheme://host:port），必须与地址栏完全一致：
# 默认 http://localhost:8080 仅限本机（回环）管理；localhost 与 127.0.0.1 不能互换，
# 端口不同也必须改这里。非回环地址的明文 HTTP 只提供公开只读面板，后台管理必须用 HTTPS。
PUBLIC_ORIGIN=http://localhost:8080

# 登录接口每 IP 每分钟允许的尝试次数（默认 5）。
# 仅在确有需要（例如内网自动化）时调高；调高会削弱对密码枚举的防护。
AUTH_LOGIN_RATE_LIMIT=5

# 受信反向代理地址（逗号分隔的 IP 或 CIDR，默认不信任任何转发头）。
# 只有直连方命中这个列表时才会采用 X-Forwarded-For 来判定客户端 IP；
# 不配置时 request.ip 就是直连来源，此时"每 IP 限速"在反代后面会退化为全站共享一个桶。
# 例：TRUSTED_PROXY=127.0.0.1,::1
# 不接受 true / * / 主机名 之类的宽松取值——那会让任意请求伪造来源 IP。
#TRUSTED_PROXY=127.0.0.1,::1

# 宿主机侧监听地址：默认只绑定 127.0.0.1，不直接把 8080 暴露到公网。
BIND_ADDRESS=127.0.0.1

# 容器内监听地址：0.0.0.0 表示监听容器内全部网卡；外部可见性仍由 BIND_ADDRESS 决定。
HOST=0.0.0.0

# 容器内监听端口：默认 8080；compose 的宿主端口映射会自动跟随本值。
PORT=8080

# 容器内时区：影响日志时间与"7 天更新标记"等服务器时间判断。
TZ=Asia/Shanghai

# 前端静态资源目录：服务端从这里提供页面与静态文件（未构建时页面路由返回 503，API 不受影响）。
# 默认值随服务端 dist 相对定位，仓库内即 apps/web/dist——本地开发构建前端后指向的正是它，
# 一般无需设置；只有把前端产物构建到别处时才需要显式指定。
#WEB_DIST_PATH=apps/web/dist

# NODE_ENV：只接受 development / test / production（默认 development）。
# 部署时由 Dockerfile 运行阶段与 compose.yaml 注入 production，本地开发无需设置。
